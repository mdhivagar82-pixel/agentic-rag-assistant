# Environment Configuration for Agentic RAG Knowledge Assistant

# General Settings
PROJECT_NAME="Agentic RAG Knowledge Assistant"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# API & Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# LLM Providers (To be configured in later phases)
OPENAI_API_KEY="sk-proj-placeholder"
ANTHROPIC_API_KEY="sk-ant-placeholder"

# Search & Reranking Tools (To be configured in later phases)
COHERE_API_KEY="placeholder"
TAVILY_API_KEY="tvly-placeholder"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="knowledge_base"

# PostgreSQL Database
POSTGRES_USER="rag_user"
POSTGRES_PASSWORD="rag_password"
POSTGRES_DB="rag_assistant_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Redis Cache & Task Queue
REDIS_HOST="localhost"
REDIS_PORT=6379

# Observability (LangSmith)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="lsv2_placeholder"
LANGCHAIN_PROJECT="agentic-rag-assistant"
